# vdesign — development image (hot reload)
FROM node:22-bookworm-slim

ENV NEXT_TELEMETRY_DISABLED=1
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true

RUN npm install -g pnpm@9.15.9
WORKDIR /app

COPY package.json pnpm-lock.yaml ./
COPY app/package.json app/pnpm-lock.yaml ./app/
RUN pnpm install --frozen-lockfile
RUN pnpm --dir app install --frozen-lockfile

COPY . .

EXPOSE 3000
# Webpack HMR (not turbopack): turbopack fails to resolve `three` for ../src outside app/
CMD ["pnpm", "--dir", "app", "exec", "next", "dev", "-H", "0.0.0.0", "-p", "3000"]
